# Application
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=generate-a-long-random-value
APP_BASE_URL=http://localhost:5000

# Database: use an exclusive database per environment
DATABASE_URL=postgresql://vitalilab:change-me@localhost:5432/vitalilab_dev

# Session and abuse prevention
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
RATELIMIT_STORAGE_URI=memory://

# SMTP for password recovery (optional in local; required for a complete shared environment)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
PASSWORD_RESET_MAX_AGE=3600

# Observability
LOG_LEVEL=INFO
