digraph vitalilab {
graph [rankdir=LR, bgcolor="white", nodesep=0.35, ranksep=1.1, splines=polyline];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=8, color="#64756e", arrowsize=0.65];
