[Unit]
Description=Check the VitaliLab HTTPS database readiness endpoint
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 15 https://vitalilab.lab.nexostack.app/ready
User=nobody
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
